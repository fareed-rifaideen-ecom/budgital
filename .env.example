# Server-only. Never expose this value in Vite client variables or commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Best-effort server-side daily ceiling across all clients; the browser UI also enforces 12 per local user.
GEMINI_DAILY_PROJECT_LIMIT=120

# Cloudflare Pages Function feedback delivery. Keep the API key server-side.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=
